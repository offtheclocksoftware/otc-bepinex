<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests for otc-bepinex: compiles the library for the Mono target (OTC_MONO) against the stub
       UnityEngine / BepInEx / HarmonyLib types in Stubs\ (no game, no NuGet packages) and runs a plain console runner.
       How to run: README.md, section "Tests". Exit code 0 = all passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>OtcLib.Tests</AssemblyName>
    <RootNamespace>OtcLib.Tests</RootNamespace>
    <Deterministic>true</Deterministic>
    <OtcRuntime>Mono</OtcRuntime>
  </PropertyGroup>
  <Import Project="..\OtcBepInEx.props" />
</Project>
